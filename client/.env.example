VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=
# Real WhatsApp Business number in international format, digits only
# (country code + number, no +, spaces, or dashes) — e.g. 919812345678
# for a +91 98123 45678 number. Placeholder below WILL NOT reach you.
VITE_WHATSAPP_NUMBER=911234567890
# Optional — enables the "Continue with Google" button on /account.
# Leave blank to hide it (safe no-op, not an error) if you haven't set
# up a Google OAuth client yet.
VITE_GOOGLE_CLIENT_ID=
