# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Frontend URL — used to build links inside emails (reset password, back-in-stock)
FRONTEND_URL=https://theoffgrid.vercel.app
CLIENT_URL=https://theoffgrid.vercel.app

# First user to register with this email is auto-promoted to admin
ADMIN_EMAIL=you@example.com

# Razorpay (online payments) — optional, COD works without these
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks (create a webhook pointed at
# https://your-api-domain/api/webhooks/razorpay, subscribed to at least
# payment.captured, payment.failed, and refund.processed).
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP) — optional. Without these, emails are printed to the
# server console instead of sent, so the app still works in dev.
# Works with any SMTP provider: Resend, SendGrid, Brevo, Zoho, Gmail (app password), etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="THE OFF GRID <orders@theoffgrid.in>"

PORT=5000

# Abandoned-cart recovery (see routes/abandoned.js)
# Secret for external schedulers (Render Cron, GitHub Actions) calling
# POST /api/admin/abandoned-carts/cron-send with header x-cron-secret.
CRON_SECRET=
# Optional built-in scheduler instead of / alongside an external one —
# only reliable on an always-on instance (see the code comment for why).
ENABLE_ABANDONED_CART_CRON=false
ABANDONED_CART_INTERVAL_HOURS=1
ABANDONED_CART_IDLE_HOURS=2
